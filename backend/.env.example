# Required in production for Groq-backed answer generation
GROQ_API_KEY=replace-with-groq-api-key

# Required in production for Firestore and Firebase Admin
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account"}'

# Optional local development fallback when using a credential file
FIREBASE_CREDENTIALS_PATH=credentials/firebase-service-account.json

# Optional: used only by legacy Gemini integrations if enabled
GEMINI_API_KEY=replace-if-used

# Optional comma-separated frontend origins in addition to the known origins
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
